# ─── Pyrogram (UserBot) — AUTH_KEY авторизация ───
# AUTH_KEY_HEX: 512 hex-символов (256 байт) авторизационного ключа.
# Экспортируйте из существующей сессии:
#   import sqlite3
#   conn = sqlite3.connect("userbot_session.session")
#   row = conn.execute("SELECT auth_key, dc_id FROM sessions").fetchone()
#   AUTH_KEY_HEX = row[0].hex()
#   DC_ID = row[1]
AUTH_KEY_HEX=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
DC_ID=2
PYROGRAM_SESSION=userbot_session

# ─── Logging ───
LOG_LEVEL=INFO
